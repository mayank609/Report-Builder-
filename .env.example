# ==========================================
# BuildReport AI - Production Environment Variables
# ==========================================

# [REQUIRED] MongoDB Atlas Connection String
# Used for storing all projects, records, reports, clients, contractors, engineers, and invoices.
# Restrict Atlas Network Access to your hosting provider's egress IPs where possible (e.g. Vercel
# Secure Compute / static IPs). Use a dedicated database user with readWrite on this DB only.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/buildreport?retryWrites=true&w=majority"

# [RECOMMENDED] Google Gemini API Key
# Used for AI template creation, AI report generation, and document import.
# Note: Users can also input their personal key directly in the Settings UI (/settings).
# If configured here in Vercel, it serves as the default fallback key.
GEMINI_API_KEY=""

# [OPTIONAL] Gemini Model Name
# Default: "gemini-2.5-flash"
GEMINI_MODEL="gemini-2.5-flash"

# [OPTIONAL] Database name (default: "report-builder")
MONGODB_DB_NAME=""

# [REQUIRED IN PRODUCTION FOR FINANCE INTEGRATION] Shared secret for /api/integration/v1.
# The Finance module sends it as "Authorization: Bearer <key>" (REPORT_BUILDER_API_KEY there).
# Without it the integration API is open in development and disabled (503) in production.
# Generate with: openssl rand -hex 32
INTEGRATION_API_KEY=""

# [OPTIONAL] Browser-facing Finance URL for "Open in Finance" links.
# NEXT_PUBLIC_* values are inlined at BUILD time — set it before `npm run build`.
NEXT_PUBLIC_FINANCE_URL="https://finance.example.com"

# [OPTIONAL] Origins allowed to embed Report Builder in an iframe (space-separated CSP sources).
# Default: 'self'. Example for a parent SaaS shell: "'self' https://app.example.com"
FRAME_ANCESTORS=""
