# ==========================================
# BuildReport AI - Production Environment Variables
# ==========================================

# [REQUIRED] MongoDB Atlas Connection String
# Used for storing all projects, records, reports, clients, contractors, engineers, and invoices.
# Make sure your MongoDB Atlas Network Access whitelist includes 0.0.0.0/0 (allow all IPs) for Vercel Serverless.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/buildreport?retryWrites=true&w=majority"

# [RECOMMENDED] Google Gemini API Key
# Used for AI template creation, AI report generation, and document import.
# Note: Users can also input their personal key directly in the Settings UI (/settings).
# If configured here in Vercel, it serves as the default fallback key.
GEMINI_API_KEY=""

# [OPTIONAL] Gemini Model Name
# Default: "gemini-2.5-flash"
GEMINI_MODEL="gemini-2.5-flash"
